NODE_ENV=development
PORT=8085
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=tripaholidays
MONGODB_MAX_POOL_SIZE=10
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=24h
CORS_ORIGINS=https://tripa-holidays-backend.vercel.app/,http://localhost:3000
SEED_ADMIN=true
ADMIN_NAME=Trip Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
OTEL_SERVICE_NAME=tripaholidays-express-api
OTEL_PROMETHEUS_PORT=9464
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
PUBLIC_API_URL=http://localhost:8085
